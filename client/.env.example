# ExamSphere Client Environment Variables

# Local Development Defaults:
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_SOCKET_URL=http://localhost:5000
VITE_APP_NAME="ExamSphere"

# Production Deployment (Vercel):
# Set VITE_API_BASE_URL to your Render backend URL with /api/v1 prefix
# Example: https://examsphere-backend.onrender.com/api/v1
# VITE_API_BASE_URL=https://<your-render-backend-url>/api/v1

# Optional: Explicit Socket.IO Gateway URL (defaults to VITE_API_BASE_URL origin if omitted)
# Example: https://examsphere-backend.onrender.com
# VITE_SOCKET_URL=https://<your-render-backend-url>

# Production Demo Accounts Guard (set to 'false' for production, or 'true' for demo/staging preview)
VITE_ENABLE_DEMO_ACCOUNTS=false
