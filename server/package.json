{
  "name": "examsphere-server",
  "version": "1.0.0",
  "description": "Backend API for ExamSphere Cloud-Based Examination & Assessment Platform",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "seed": "node prisma/seed.js",
    "test": "node --test tests/examination_engine.test.js tests/evaluation_and_monitoring.test.js tests/analytics_coding_proctoring.test.js tests/multiadmin_onboarding_rbac.test.js",
    "test:all": "node --test tests/examination_engine.test.js tests/evaluation_and_monitoring.test.js tests/api_routes.test.js",
    "test:db": "node src/scripts/testConnection.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "keywords": [
    "examination",
    "assessment",
    "examsphere",
    "express",
    "prisma",
    "postgresql",
    "redis",
    "bullmq",
    "socketio"
  ],
  "author": "ExamSphere Team",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.41.6",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.0.0",
    "ioredis": "^5.5.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.5.0",
    "socket.io": "^4.8.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.1.9",
    "prisma": "^6.4.1",
    "supertest": "^7.3.1"
  }
}
