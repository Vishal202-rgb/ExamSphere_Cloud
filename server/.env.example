# Server Port and Environment
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL with Prisma)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/examsphere_db?schema=public"

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=redispassword
REDIS_URL="redis://:redispassword@127.0.0.1:6379"

# JWT Authentication
JWT_SECRET=supersecretjwtkey_change_in_production_examsphere_2026
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=supersecretrefreshjwtkey_change_in_production_examsphere_2026
REFRESH_TOKEN_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=12
