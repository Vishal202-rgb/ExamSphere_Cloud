# ==============================================================================
# ExamSphere Server – Production & Staging Environment Variable Template (Render)
# ==============================================================================

# Server Runtime
PORT=5000
NODE_ENV=production
# URL of the deployed Vercel frontend (without trailing slash)
CLIENT_URL=https://<your-vercel-app>.vercel.app

# Database (Neon PostgreSQL connection string)
# Example: postgresql://username:password@ep-xyz.us-east-2.aws.neon.tech/examsphere?sslmode=require
DATABASE_URL="postgresql://<user>:<password>@<neon-host>/<database>?sslmode=require"

# Redis Cache & BullMQ (Upstash Redis TLS connection string)
# Example: rediss://default:<password>@<upstash-endpoint>.upstash.io:6379
REDIS_URL="rediss://default:<password>@<upstash-endpoint>.upstash.io:6379"

# JWT Authentication (Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=generate_strong_random_secret_at_least_32_characters
JWT_ACCESS_SECRET=generate_strong_random_secret_at_least_32_characters
JWT_EXPIRES_IN=1h

REFRESH_TOKEN_SECRET=generate_strong_random_refresh_secret_at_least_32_characters
JWT_REFRESH_SECRET=generate_strong_random_refresh_secret_at_least_32_characters
REFRESH_TOKEN_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=12

# Email Transport (Nodemailer SMTP)
SMTP_HOST=smtp.mailprovider.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM="ExamSphere Platform <noreply@examsphere.io>"

# Initial Super Admin Bootstrap (Guards one-time first setup)
BOOTSTRAP_TOKEN=generate_strong_random_secret_bootstrap_token
INITIAL_SUPERADMIN_NAME="Chief Administrator"
INITIAL_SUPERADMIN_EMAIL="superadmin@institution.edu"
INITIAL_SUPERADMIN_PASSWORD="YourStrongPassword@2026"
