# ==============================================================================
# ExamSphere Server – Production & Staging Environment Variable Template
# ==============================================================================

# Server Runtime
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL 16 with Prisma ORM)
DATABASE_URL="postgresql://postgres:postgrespassword@127.0.0.1:5432/examsphere_db?schema=public&connection_limit=25"

# Redis Configuration (BullMQ Queues & Socket.IO State)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=redispassword
REDIS_URL="redis://:redispassword@127.0.0.1:6379"

# JWT Authentication (Keep secrets 32+ characters)
JWT_SECRET=examsphere_dev_jwt_secret_key_2026_at_least_32_chars
JWT_ACCESS_SECRET=examsphere_dev_jwt_secret_key_2026_at_least_32_chars
JWT_EXPIRES_IN=1h

REFRESH_TOKEN_SECRET=examsphere_dev_refresh_token_secret_key_2026_32_chars
JWT_REFRESH_SECRET=examsphere_dev_refresh_token_secret_key_2026_32_chars
REFRESH_TOKEN_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=12
