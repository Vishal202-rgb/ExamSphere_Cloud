// ==============================================================================
// ExamSphere – Relational Database Schema (PostgreSQL 16 via Prisma ORM)
// Enterprise-Grade Online Examination & Assessment Platform
// ==============================================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------------------
// Enums
// ------------------------------------------------------------------------------

enum UserRole {
  ADMIN
  FACULTY
  STUDENT
}

enum QuestionType {
  SINGLE_MCQ
  MULTIPLE_MCQ
  TRUE_FALSE
  DESCRIPTIVE
  CODING
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

enum ExamStatus {
  DRAFT
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  AUTO_SUBMITTED
  EVALUATED
  CANCELLED
  DISQUALIFIED
}

enum SubmissionReason {
  MANUAL
  AUTO_TIMEOUT
  ADMIN_TERMINATED
  DISQUALIFIED
}

enum EvaluationStatus {
  PENDING
  AUTO_EVALUATED
  MANUAL_EVALUATION_PENDING
  EVALUATED
  FAILED
}

enum ResultPublicationStatus {
  DRAFT
  PUBLISHED
  WITHHELD
}

enum EnrollmentStatus {
  ACTIVE
  DROPPED
  COMPLETED
}

enum NotificationType {
  INFO
  EXAM_SCHEDULED
  EXAM_REMINDER
  EXAM_ASSIGNED
  EXAM_STARTING_SOON
  EXAM_CANCELLED
  EXAM_SUBMITTED
  RESULT_PUBLISHED
  EVALUATION_REQUIRED
  ANNOUNCEMENT
  ALERT
}

enum CodingSubmissionStatus {
  PENDING
  RUNNING
  ACCEPTED
  WRONG_ANSWER
  TIME_LIMIT_EXCEEDED
  MEMORY_LIMIT_EXCEEDED
  COMPILATION_ERROR
  RUNTIME_ERROR
  INTERNAL_ERROR
  SETUP_REQUIRED
}

enum ProctoringEventType {
  TAB_BLUR
  TAB_FOCUS
  FULLSCREEN_EXIT
  FULLSCREEN_ENTER
  DISCONNECT
  RECONNECT
  SUSPICIOUS_KEY
}

// ------------------------------------------------------------------------------
// 1. Department Model
// ------------------------------------------------------------------------------

model Department {
  id          String   @id @default(uuid())
  name        String   @unique
  code        String   @unique
  description String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationships
  users       User[]
  courses     Course[]

  @@index([name])
  @@index([code])
  @@map("departments")
}

// ------------------------------------------------------------------------------
// 2. User Model (RBAC: Admin, Faculty, Student)
// ------------------------------------------------------------------------------

model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  password     String     // Bcrypt hashed password
  role         UserRole   @default(STUDENT)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  rollNumber   String?    @unique // Nullable for Faculty and Admin
  batch        String?    // e.g. "2023-2027"
  section      String?    // e.g. "A"
  avatarUrl    String?
  isActive     Boolean    @default(true)
  refreshToken        String?    @db.Text
  resetPasswordToken  String?    @db.Text
  resetPasswordExpiry DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  // Relationships
  facultyCourses     CourseFaculty[]
  studentEnrollments StudentEnrollment[]
  createdQuestions   Question[]          @relation("QuestionCreatedBy")
  createdExams       Exam[]              @relation("ExamCreatedBy")
  assignedExams      ExamAssignment[]    @relation("StudentAssignedExams")
  attempts           Attempt[]           @relation("StudentAttempts")
  results            Result[]            @relation("StudentResults")
  notifications      Notification[]
  auditLogs          AuditLog[]
  sentAnnouncements  ExamAnnouncement[]  @relation("SenderAnnouncements")
  evaluatedAnswers   Answer[]            @relation("EvaluatedAnswers")
  codingSubmissions  CodingSubmission[]  @relation("StudentCodingSubmissions")
  proctoringEvents   ProctoringEvent[]   @relation("StudentProctoringEvents")

  @@index([email])
  @@index([role])
  @@index([departmentId])
  @@index([rollNumber])
  @@index([batch, section])
  @@map("users")
}

// ------------------------------------------------------------------------------
// 3. Course Model
// ------------------------------------------------------------------------------

model Course {
  id           String     @id @default(uuid())
  code         String     @unique // e.g. "CS301"
  title        String
  description  String?    @db.Text
  credits      Int        @default(3)
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  // Relationships
  facultyMembers CourseFaculty[]
  enrolledStudents StudentEnrollment[]
  questions      Question[]
  exams          Exam[]
  examCourses    ExamCourse[]

  @@index([code])
  @@index([departmentId])
  @@map("courses")
}

// ------------------------------------------------------------------------------
// 4. CourseFaculty Model (Many-to-Many Join: Course <-> Faculty User)
// ------------------------------------------------------------------------------

model CourseFaculty {
  id            String   @id @default(uuid())
  courseId      String
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  facultyId     String
  faculty       User     @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  isCoordinator Boolean  @default(false)
  assignedAt    DateTime @default(now())

  @@unique([courseId, facultyId])
  @@index([courseId])
  @@index([facultyId])
  @@map("course_faculty")
}

// ------------------------------------------------------------------------------
// 5. StudentEnrollment Model (Many-to-Many Join: Course <-> Student User)
// ------------------------------------------------------------------------------

model StudentEnrollment {
  id         String           @id @default(uuid())
  courseId   String
  course     Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  studentId  String
  student    User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status     EnrollmentStatus @default(ACTIVE)
  enrolledAt DateTime         @default(now())

  @@unique([courseId, studentId])
  @@index([courseId])
  @@index([studentId])
  @@index([status])
  @@map("student_enrollments")
}

// ------------------------------------------------------------------------------
// 6. Question Model (Question Bank)
// ------------------------------------------------------------------------------

model Question {
  id            String             @id @default(uuid())
  questionText  String             @db.Text
  type          QuestionType       @default(SINGLE_MCQ)
  difficulty    QuestionDifficulty @default(MEDIUM)
  marks         Float              @default(1.0)
  negativeMarks Float              @default(0.0)
  courseId      String
  course        Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdById   String
  createdBy     User               @relation("QuestionCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  topicTags     String[]           @default([])
  explanation   String?            @db.Text // Faculty notes/explanation
  isActive      Boolean            @default(true) // Supports archive and soft deletion
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  // Relationships
  options           QuestionOption[]
  examQuestions     ExamQuestion[]
  answers           Answer[]
  codingDetail      CodingQuestionDetail?
  codingSubmissions CodingSubmission[]

  @@index([courseId])
  @@index([createdById])
  @@index([type])
  @@index([difficulty])
  @@index([isActive])
  @@map("questions")
}

// ------------------------------------------------------------------------------
// 7. QuestionOption Model
// NOTE: `isCorrect` must NEVER be selected/exposed in student-facing query APIs
// ------------------------------------------------------------------------------

model QuestionOption {
  id         String   @id @default(uuid())
  optionText String   @db.Text
  isCorrect  Boolean  @default(false)
  orderIndex Int      @default(0)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([questionId])
  @@index([questionId, orderIndex])
  @@map("question_options")
}

// ------------------------------------------------------------------------------
// 8. Exam Model
// ------------------------------------------------------------------------------

model Exam {
  id               String          @id @default(uuid())
  title            String
  description      String?         @db.Text
  courseId         String
  course           Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdById      String
  createdBy        User            @relation("ExamCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  durationMinutes  Int             @default(60)
  totalMarks       Float           @default(100.0)
  passingMarks     Float           @default(40.0)
  startTime        DateTime
  endTime          DateTime
  status           ExamStatus      @default(DRAFT)
  isPublished      Boolean         @default(false)
  shuffleQuestions Boolean         @default(false)
  shuffleOptions   Boolean         @default(false)
  negativeMarking  Boolean         @default(false)
  maxAttempts      Int             @default(1)
  autoSubmit       Boolean         @default(true)
  allowLateEntry   Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt


  // Relationships
  courses           ExamCourse[]
  examQuestions     ExamQuestion[]
  assignments       ExamAssignment[]
  attempts          Attempt[]
  results           Result[]
  announcements     ExamAnnouncement[]
  codingSubmissions CodingSubmission[]

  @@index([courseId])
  @@index([createdById])
  @@index([status])
  @@index([startTime])
  @@index([endTime])
  @@index([courseId, status])
  @@map("exams")
}

// ------------------------------------------------------------------------------
// 8a. ExamCourse Model (Many-to-Many Join: Exam <-> Course)
// Supports exams associated with multiple authorized academic courses
// ------------------------------------------------------------------------------

model ExamCourse {
  id        String   @id @default(uuid())
  examId    String
  exam      Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([examId, courseId])
  @@index([examId])
  @@index([courseId])
  @@map("exam_courses")
}

// ------------------------------------------------------------------------------
// 9. ExamQuestion Model (Exam <-> Question Join Table with Order & Overrides)
// ------------------------------------------------------------------------------

model ExamQuestion {
  id            String    @id @default(uuid())
  examId        String
  exam          Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
  questionId    String
  question      Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  orderIndex    Int       @default(0)
  marks         Float?    // Optional exam-specific mark override
  negativeMarks Float?    // Optional exam-specific negative mark override
  createdAt     DateTime  @default(now())

  @@unique([examId, questionId])
  @@index([examId])
  @@index([questionId])
  @@index([examId, orderIndex])
  @@map("exam_questions")
}

// ------------------------------------------------------------------------------
// 10. ExamAssignment Model (Targeted Exam Roster / Student Eligibility)
// ------------------------------------------------------------------------------

model ExamAssignment {
  id               String   @id @default(uuid())
  examId           String
  exam             Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId        String
  student          User     @relation("StudentAssignedExams", fields: [studentId], references: [id], onDelete: Cascade)
  extraTimeMinutes Int      @default(0) // Special accommodation extra time
  isDisqualified   Boolean  @default(false)
  disqualifyReason String?  @db.Text
  assignedAt       DateTime @default(now())

  @@unique([examId, studentId])
  @@index([examId])
  @@index([studentId])
  @@index([examId, isDisqualified])
  @@map("exam_assignments")
}

// ------------------------------------------------------------------------------
// 11. Attempt Model (Student Exam Session)
// ------------------------------------------------------------------------------

model Attempt {
  id             String        @id @default(uuid())
  examId         String
  exam           Exam          @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId      String
  student        User          @relation("StudentAttempts", fields: [studentId], references: [id], onDelete: Cascade)
  attemptNumber  Int           @default(1)
  startedAt      DateTime      @default(now())
  expiresAt      DateTime
  submittedAt    DateTime?
  status         AttemptStatus @default(IN_PROGRESS)
  obtainedMarks  Float         @default(0.0)
  tabSwitchCount   Int               @default(0)
  violationCount   Int               @default(0)
  isDisqualified   Boolean           @default(false)
  disqualifiedAt   DateTime?
  disqualifyReason String?           @db.Text
  ipAddress        String?
  userAgent        String?
  submissionReason SubmissionReason?
  evaluationStatus EvaluationStatus  @default(PENDING)
  evaluationError  String?           @db.Text
  evaluatedAt      DateTime?
  questionOrder    Json?             // Array of question UUIDs in attempt order
  optionOrder      Json?             // Map of question UUID -> array of option UUIDs in attempt order
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  // Relationships
  answers           Answer[]
  result            Result?
  codingSubmissions CodingSubmission[]
  proctoringEvents  ProctoringEvent[]

  @@unique([examId, studentId, attemptNumber])
  @@index([examId])
  @@index([studentId])
  @@index([status])
  @@index([examId, studentId])
  @@index([examId, status])
  @@index([status, expiresAt])
  @@map("attempts")
}

// ------------------------------------------------------------------------------
// 12. Answer Model (Student Response per Question)
// Enforces Unique constraint on [attemptId, questionId]
// ------------------------------------------------------------------------------

model Answer {
  id                String    @id @default(uuid())
  attemptId         String
  attempt           Attempt   @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId        String
  question          Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOptions   Json?     // Array of selected Option UUIDs for MCQ / TrueFalse
  descriptiveAnswer String?   @db.Text // Text answer for DESCRIPTIVE questions
  isCorrect         Boolean?  // Computed during auto/manual evaluation
  marksAwarded      Float     @default(0.0)
  facultyFeedback   String?   @db.Text
  evaluatedAt       DateTime?
  evaluatedById     String?
  evaluatedBy       User?     @relation("EvaluatedAnswers", fields: [evaluatedById], references: [id], onDelete: SetNull)
  markedForReview   Boolean   @default(false)
  version           Int       @default(1) // Optimistic concurrency version check
  savedTimestamp    DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
  @@map("answers")
}

// ------------------------------------------------------------------------------
// 13. Result Model (Evaluated Exam Scores & Rankings)
// ------------------------------------------------------------------------------

model Result {
  id                   String                  @id @default(uuid())
  studentId            String
  student              User                    @relation("StudentResults", fields: [studentId], references: [id], onDelete: Cascade)
  examId               String
  exam                 Exam                    @relation(fields: [examId], references: [id], onDelete: Cascade)
  attemptId            String                  @unique
  attempt              Attempt                 @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  obtainedMarks        Float
  totalMarks           Float
  percentage           Float
  correctAnswersCount  Int                     @default(0)
  incorrectAnswersCount Int                    @default(0)
  unansweredCount      Int                     @default(0)
  rank                 Int?
  isPassed             Boolean?
  evaluationStatus     EvaluationStatus        @default(PENDING)
  evaluationNotes      String?                 @db.Text
  evaluatedAt          DateTime?
  publicationStatus    ResultPublicationStatus @default(DRAFT)
  publishedAt          DateTime?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@index([studentId])
  @@index([examId])
  @@index([attemptId])
  @@index([examId, studentId])
  @@index([examId, rank])
  @@index([examId, publicationStatus])
  @@index([studentId, publicationStatus])
  @@map("results")
}

// ------------------------------------------------------------------------------
// 14. Notification Model
// ------------------------------------------------------------------------------

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String           @db.Text
  type      NotificationType @default(INFO)
  isRead    Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ------------------------------------------------------------------------------
// 14b. ExamAnnouncement Model
// ------------------------------------------------------------------------------

model ExamAnnouncement {
  id        String   @id @default(uuid())
  examId    String
  exam      Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation("SenderAnnouncements", fields: [senderId], references: [id], onDelete: Cascade)
  title     String
  message   String   @db.Text
  createdAt DateTime @default(now())

  @@index([examId])
  @@index([senderId])
  @@index([createdAt])
  @@map("exam_announcements")
}

// ------------------------------------------------------------------------------
// 15. AuditLog Model (Security & Compliance Tracking)
// ------------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  resource   String?
  resourceId String?
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  timestamp  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([timestamp])
  @@index([userId, timestamp])
  @@map("audit_logs")
}

// ------------------------------------------------------------------------------
// 16. CodingQuestionDetail Model
// Extended metadata for CODING question type
// ------------------------------------------------------------------------------

model CodingQuestionDetail {
  id               String           @id @default(uuid())
  questionId       String           @unique
  question         Question         @relation(fields: [questionId], references: [id], onDelete: Cascade)
  inputFormat      String?          @db.Text
  outputFormat     String?          @db.Text
  constraints      String?          @db.Text
  allowedLanguages Json?            // e.g. ["javascript", "python", "java", "cpp"]
  starterCode      Json?            // e.g. {"javascript": "// code here", "python": "# code here"}
  timeLimitSec     Float            @default(2.0)
  memoryLimitMb    Int              @default(256)
  evaluationPolicy String           @default("ALL_TEST_CASES") // "ALL_TEST_CASES", "PERCENTAGE"
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  // Relationships
  testCases        CodingTestCase[]

  @@map("coding_question_details")
}

// ------------------------------------------------------------------------------
// 17. CodingTestCase Model
// Test cases for automated code validation (Sample vs Hidden)
// NOTE: `isSample = false` test cases must NEVER be exposed to student query APIs
// ------------------------------------------------------------------------------

model CodingTestCase {
  id             String               @id @default(uuid())
  codingDetailId String
  codingDetail   CodingQuestionDetail @relation(fields: [codingDetailId], references: [id], onDelete: Cascade)
  input          String               @db.Text
  expectedOutput String               @db.Text
  isSample       Boolean              @default(false)
  explanation    String?              @db.Text
  weight         Float                @default(1.0)
  orderIndex     Int                  @default(0)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([codingDetailId])
  @@index([codingDetailId, isSample])
  @@map("coding_test_cases")
}

// ------------------------------------------------------------------------------
// 18. CodingSubmission Model
// Records each code execution / submission run by a student
// ------------------------------------------------------------------------------

model CodingSubmission {
  id              String                 @id @default(uuid())
  studentId       String
  student         User                   @relation("StudentCodingSubmissions", fields: [studentId], references: [id], onDelete: Cascade)
  questionId      String
  question        Question               @relation(fields: [questionId], references: [id], onDelete: Cascade)
  attemptId       String?
  attempt         Attempt?               @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  examId          String?
  exam            Exam?                  @relation(fields: [examId], references: [id], onDelete: Cascade)
  sourceCode      String                 @db.Text
  language        String
  status          CodingSubmissionStatus @default(PENDING)
  totalTestCases  Int                    @default(0)
  passedTestCases Int                    @default(0)
  marksAwarded    Float                  @default(0.0)
  executionTimeMs Float?
  memoryUsedKb    Int?
  compileOutput   String?                @db.Text
  executionOutput Json?                  // Detailed array of results per test case
  errorMessage    String?                @db.Text
  isSampleRun     Boolean                @default(false)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([studentId])
  @@index([questionId])
  @@index([attemptId])
  @@index([examId])
  @@index([status])
  @@map("coding_submissions")
}

// ------------------------------------------------------------------------------
// 19. ProctoringEvent Model
// Privacy-conscious browser telemetry & integrity logs during an active attempt
// ------------------------------------------------------------------------------

model ProctoringEvent {
  id         String              @id @default(uuid())
  attemptId  String
  attempt    Attempt             @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  studentId  String
  student    User                @relation("StudentProctoringEvents", fields: [studentId], references: [id], onDelete: Cascade)
  eventType  ProctoringEventType
  details    Json?
  clientTime DateTime            @default(now())
  serverTime DateTime            @default(now())

  @@index([attemptId])
  @@index([studentId])
  @@index([eventType])
  @@index([attemptId, clientTime])
  @@map("proctoring_events")
}

