# ==============================================================================
# ExamSphere – Global Environment Configuration Template
# ==============================================================================

# Server Environment
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL & Prisma Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=examsphere_db
POSTGRES_PORT=5432
DATABASE_URL="postgresql://postgres:postgrespassword@127.0.0.1:5432/examsphere_db?schema=public"

# Redis Configuration (BullMQ & Cache & Session)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=redispassword
REDIS_URL="redis://:redispassword@127.0.0.1:6379"

# Security & Authentication
JWT_SECRET=supersecretjwtkey_change_in_production_examsphere_2026
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=supersecretrefreshjwtkey_change_in_production_examsphere_2026
REFRESH_TOKEN_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=12

# Frontend Client Environment (Vite)
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_SOCKET_URL=http://localhost:5000
