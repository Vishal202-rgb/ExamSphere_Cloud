# ==============================================================================
# ExamSphere – Production & Staging Environment Variable Template
# Copy to .env and configure strong, secret values before starting services
# NEVER COMMIT REAL CREDENTIALS OR .env TO VERSION CONTROL
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Runtime
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=5000
HTTP_PORT=80
HTTPS_PORT=443
CLIENT_URL=https://examsphere.college.edu
BACKEND_URL=https://examsphere.college.edu/api/v1
CORS_ORIGINS=https://examsphere.college.edu,http://localhost:5173

# ------------------------------------------------------------------------------
# 2. Relational Database (PostgreSQL 16)
# ------------------------------------------------------------------------------
POSTGRES_USER=examsphere_admin
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD_MIN_24_CHARS
POSTGRES_DB=examsphere_db
POSTGRES_PORT=5432
DATABASE_URL="postgresql://examsphere_admin:CHANGE_ME_STRONG_DB_PASSWORD_MIN_24_CHARS@postgres:5432/examsphere_db?schema=public&connection_limit=25&pool_timeout=10"

# ------------------------------------------------------------------------------
# 3. Redis Cache & BullMQ Queue
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD_MIN_24_CHARS
REDIS_URL="redis://:CHANGE_ME_STRONG_REDIS_PASSWORD_MIN_24_CHARS@redis:6379"

# ------------------------------------------------------------------------------
# 4. Authentication, Tokens & Cryptography
# ------------------------------------------------------------------------------
# High-entropy random 256-bit strings (e.g., generated with `openssl rand -hex 32`)
JWT_SECRET=GENERATE_OPENSSL_RAND_HEX_32_FOR_JWT_ACCESS
JWT_ACCESS_SECRET=GENERATE_OPENSSL_RAND_HEX_32_FOR_JWT_ACCESS
JWT_EXPIRES_IN=1h

REFRESH_TOKEN_SECRET=GENERATE_OPENSSL_RAND_HEX_32_FOR_JWT_REFRESH
JWT_REFRESH_SECRET=GENERATE_OPENSSL_RAND_HEX_32_FOR_JWT_REFRESH
REFRESH_TOKEN_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=12

# ------------------------------------------------------------------------------
# 5. External Code Execution Provider (Optional Sandbox Integration)
# Default: Resilient built-in test-runner sandbox
# ------------------------------------------------------------------------------
CODE_EXECUTION_PROVIDER=builtin
# JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
# JUDGE0_API_KEY=YOUR_RAPIDAPI_KEY_HERE
# PISTON_API_URL=https://emkc.org/api/v2/piston

# ------------------------------------------------------------------------------
# 6. SMTP Email Notifications (Optional for Production College Pilot)
# ------------------------------------------------------------------------------
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USER=postmaster@examsphere.college.edu
# SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
# EMAIL_FROM="ExamSphere Notifications <noreply@examsphere.college.edu>"

# ------------------------------------------------------------------------------
# 7. AWS Cloud Integration (For Private Report & Snapshot Storage)
# ------------------------------------------------------------------------------
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
# AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY
# AWS_S3_BUCKET_NAME=examsphere-department-reports-prod

# ------------------------------------------------------------------------------
# 8. Frontend Environment (Vite Client Build)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=/api/v1
VITE_SOCKET_URL=/
